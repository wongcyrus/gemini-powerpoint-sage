# Environment Variables for Gemini Powerpoint Sage

# Google Cloud Configuration
# Required for Vertex AI integration

# Your Google Cloud project ID(s) - supports comma-separated list for load balancing
# Get this from: https://console.cloud.google.com/welcome
# Single project: GOOGLE_CLOUD_PROJECT=your-project-id
# Multiple projects (load balancing): GOOGLE_CLOUD_PROJECTS=project1,project2,project3
GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_PROJECTS=your-project-id1,your-project-id2,your-project-id3

# Google Cloud region for Vertex AI
# Common options: global, us-central1, europe-west1, us-west1, asia-northeast1
GOOGLE_CLOUD_LOCATION=global

# Use Vertex AI (set to True for production)
GOOGLE_GENAI_USE_VERTEXAI=True

# (Optional) Path to service account JSON file
# If not set, Application Default Credentials (ADC) will be used
# Get ADC by running: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# (Optional) Custom progress file path
# SPEAKER_NOTE_PROGRESS_FILE=custom_progress.json

# (Optional) Retry slides with errors
# SPEAKER_NOTE_RETRY_ERRORS=true

# (Optional) Force fallback image generation
# FORCE_FALLBACK_IMAGE_GEN=true

# (Optional) Fallback Imagen model
# FALLBACK_IMAGEN_MODEL=imagen-3.0-generate-001

# Model Configuration
# Override default models if they're not available in your region/project
# Check available models: https://docs.cloud.google.com/gemini-enterprise-agent-platform/models/google-models
# MODEL_ANALYST=gemini-3.5-flash
# MODEL_DESIGNER=gemini-3.1-flash-image
# MODEL_DESIGNER_SECONDARY=gemini-3.1-flash-image
# MODEL_IMAGE_TRANSLATOR=gemini-3.1-flash-image
# MODEL_OVERVIEWER=gemini-3.5-flash
# MODEL_SUPERVISOR=gemini-3.5-flash
# MODEL_WRITER=gemini-3.5-flash
# MODEL_AUDITOR=gemini-3.5-flash
# MODEL_TRANSLATOR=gemini-3.5-flash
# MODEL_REFINER=gemini-3.5-flash
# MODEL_VIDEO_GENERATOR=gemini-3.5-flash
# MODEL_TTS=gemini-3.1-flash-tts-preview

# Presentation Style/Theme
# Influences both speaker notes and slide visuals
# Examples: Gundam, Cyberpunk, Minimalist, Corporate, Professional (default)
# PRESENTATION_STYLE=Professional
